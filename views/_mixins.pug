mixin statusBadge(status)
  - const st = statusInfo[status] || statusInfo.private
  span.status-badge(class=status)
    i.fa-solid(class=st.icon)
    | #{st.label}

mixin typeBadge(type, suffix)
  span.type-badge(class=type)
    i.fa-solid(class=typeInfo[type].icon)
    | #{typeInfo[type].label}#{suffix || ''}

mixin stars(avg, rateable)
  .stars(class=rateable ? 'rateable' : '' role=rateable ? 'radiogroup' : 'img' aria-label=`التقييم ${avg} من 5`)
    each n in [1, 2, 3, 4, 5]
      - const icon = avg >= n ? 'fa-solid fa-star' : avg >= n - 0.5 ? 'fa-solid fa-star-half-stroke' : 'fa-regular fa-star'
      if rateable
        button.star(type='button' data-value=n aria-label=`${n} من 5`)
          i(class=icon)
      else
        span.star
          i(class=icon)

mixin emptyState(icon, title, text)
  .empty-state
    .empty-illustration
      span
      span
      span
        i.fa-solid(class=icon)
    h3= title
    p= text
    if block
      block

//- library group (المكتبة)
mixin libraryCard(g)
  - const publishLabel = { private: 'نشر للمجتمع', rejected: 'إعادة النشر', pending: 'قيد المراجعة', published: 'منشورة' }
  article.group-card.library-card(data-group-id=g._id data-name=g.name data-description=g.description data-status=g.status data-search=g.name)
    a.group-card-link(href=`/anki/library/${g._id}` aria-label=`فتح ${g.name}`)
    .group-card-head
      .group-avatar(style=`--hue:${hue(g.name)}`)= firstLetter(g.name)
      +statusBadge(g.status)
    h3.group-name= g.name
    +dueChip(g)
    .group-meta
      span
        i.fa-solid.fa-layer-group
        span.cards-count= g.cardsCount
        |  بطاقة
      span
        i.fa-regular.fa-clock
        | #{timeAgo(g.updatedAt)}
    .group-actions
      button.btn-chip.publish-btn(type='button' disabled=(g.status === 'pending' || g.status === 'published') class=g.status === 'pending' ? 'is-pending' : g.status === 'published' ? 'is-published' : '')
        i.fa-solid(class=g.status === 'published' ? 'fa-globe' : g.status === 'pending' ? 'fa-hourglass-half' : 'fa-paper-plane')
        span= publishLabel[g.status]
      button.icon-btn.edit-group-btn(type='button' title='تعديل الاسم' aria-label='تعديل الاسم')
        i.fa-solid.fa-pen
      button.icon-btn.danger.delete-group-btn(type='button' title='حذف المجموعة' aria-label='حذف المجموعة')
        i.fa-solid.fa-trash

//- official group (المنهج)
mixin officialCard(g)
  - const isAdmin = typeof user !== 'undefined' && user && user.role === 'admin'
  - const locked = typeof user !== 'undefined' && g.isLockedFor && g.isLockedFor(user)
  - const courseTitle = g.subcourse && g.subcourse.title
  article.group-card.official-card(data-group-id=g._id data-name=g.name data-search=`${g.name} ${g.subject || ''}` class=locked ? 'is-locked' : null)
    a.group-card-link(href=locked ? `/courses/${g.subcourse._id || g.subcourse}/view` : `/anki/official/${g._id}` aria-label=locked ? `شراء ${courseTitle || 'الكورس'}` : `فتح ${g.name}`)
    .official-thumb
      if g.photo
        img(src=g.photo alt=g.name loading='lazy')
      else
        .thumb-fallback(aria-hidden='true')
          i.fa-solid.fa-layer-group
          span= (g.name || '').trim().charAt(0)
      span.thumb-chip
        i.fa-solid.fa-layer-group
        |  #{g.cardsCount} بطاقة
      if locked
        span.lock-chip.on-thumb
          i.fa-solid.fa-lock
          |  مقفلة
      if g.status !== 'published'
        span.draft-chip.on-thumb
          i.fa-solid.fa-eye-slash
          |  مسودة
    .official-body
      if g.subject
        span.subject= g.subject
      h3.group-name= g.name
      if courseTitle
        span.course-chip(class=locked ? 'locked' : null)
          i.fa-solid(class=locked ? 'fa-lock' : 'fa-book-open')
          |  #{locked ? 'متاحة لمشتركي:' : 'بطاقات كورس:'} #{courseTitle}
      if !locked
        +dueChip(g)
      if locked
        .group-actions.buy-actions
          if g.price > 0
            button.btn-chip.buy-group-btn(type='button' data-price=g.price)
              i.fa-solid.fa-cart-shopping
              |  شراء بـ #{g.price} ATP
          a.btn-chip.course-link-btn(href=`/courses/${g.subcourse._id || g.subcourse}/view`)
            i.fa-solid.fa-book-open
            |  شراء الكورس
      .group-meta
        if g.level
          span
            i.fa-solid.fa-graduation-cap
            | #{g.level}
        span
          i.fa-solid.fa-users
          | #{g.usersCount} طالب
      if isAdmin
        .group-actions
          a.btn-chip(href=`/anki/official/${g._id}/edit`)
            i.fa-solid.fa-pen
            |  تعديل
          a.icon-btn(href=`/anki/official/${g._id}/edit?tab=edit` title='البطاقات' aria-label='بطاقات المجموعة')
            i.fa-solid.fa-clone
          button.icon-btn.danger.delete-official-btn(type='button' title='حذف المجموعة' aria-label='حذف المجموعة')
            i.fa-solid.fa-trash

//- community group (المجتمع)
//- rank = place in the "best" order; your own groups show "مجموعتك" + rank and can't be rated
mixin communityCard(g, preview, rank)
  - const ownerId = g.owner && (g.owner._id || g.owner)
  - const isOwn = !preview && typeof user !== 'undefined' && user && ownerId && ownerId.toString() === user._id.toString()
  article.group-card.community-card(class=isOwn ? 'is-own' : '' data-group-id=g._id data-search=g.name data-rate-group=isOwn ? undefined : g._id data-score=g.communityScore data-rating=g.ratingsAverage data-ratings=g.ratingsQuantity data-users=g.usersCount data-published=g.publishedAt ? new Date(g.publishedAt).getTime() : 0)
    if !preview
      a.group-card-link(href=isOwn ? `/anki/library/${g._id}?tab=publish` : `/anki/community/${g._id}` aria-label=`فتح ${g.name}`)
      span.rank-badge(hidden)
    .group-card-head
      .group-avatar(style=`--hue:${hue(g.name)}`)= firstLetter(g.name)
      .owner
        span بواسطة
        strong= isOwn || !(g.owner && g.owner.name) ? 'أنت' : g.owner.name
    if isOwn
      .own-chips
        span.own-chip
          i.fa-solid.fa-user-check
          |  مجموعتك
        if rank
          span.own-chip.is-rank
            i.fa-solid.fa-trophy
            |  المرتبة #{rank} في المجتمع
    h3.group-name= g.name
    if !preview
      +dueChip(g)
    .community-stats
      span(title='عدد البطاقات')
        i.fa-solid.fa-layer-group
        | #{g.cardsCount} بطاقة
      span(title='عدد المستخدمين')
        i.fa-solid.fa-users
        span.users-count= g.usersCount
        |  مستخدم
    .rating-row
      - const studied = typeof progressMap !== 'undefined' && progressMap[g._id.toString()] && progressMap[g._id.toString()].started
      +stars(g.ratingsAverage, !preview && !isOwn && studied)
      span.rating-value= g.ratingsAverage.toFixed(1)
      span.rating-count (#[span.rating-quantity= g.ratingsQuantity] تقييم)

//- "N ready" chip on group cards (progressMap comes from the home page)
mixin dueChip(g)
  - const p = typeof progressMap !== 'undefined' && progressMap[g._id.toString()]
  if p && p.dueNow
    span.due-chip(title='بطاقات جاهزة للمراجعة')
      i.fa-solid.fa-rotate
      |  #{p.dueNow} جاهزة
  else if p && p.started
    span.due-chip.is-done(title='لا توجد بطاقات جاهزة الآن')
      i.fa-solid.fa-check
      |  تمت المراجعة

//- study (all cards) + revision (due cards only, locked until the first study)
mixin studyModes(group, progress)
  .study-modes
    a.mode-btn.mode-study(href=`/anki/groups/${group._id}/study`)
      span.mode-icon
        i.fa-solid.fa-book-open
      span.mode-text
        strong دراسة
        small كل البطاقات (#{group.cardsCount})
    if progress.started
      a.mode-btn.mode-revision(href=`/anki/groups/${group._id}/study?mode=revision` class=progress.dueNow ? 'has-due' : '')
        span.mode-icon
          i.fa-solid.fa-rotate
        span.mode-text
          strong مراجعة
          small= progress.dueNow ? `${progress.dueNow} بطاقة جاهزة الآن` : progress.nextDueAt ? `البطاقة التالية ${dueIn(progress.nextDueAt)}` : 'لا توجد بطاقات جاهزة'
        if progress.dueNow
          span.due-count= progress.dueNow
    else
      span.mode-btn.mode-revision.is-locked(aria-disabled='true' title='ادرس المجموعة مرة واحدة أولاً')
        span.mode-icon
          i.fa-solid.fa-lock
        span.mode-text
          strong مراجعة
          small ادرس المجموعة مرة واحدة أولاً
  if progress.started
    .study-progress
      .study-progress-text
        span درست #[strong= Math.min(progress.studied, group.cardsCount)] من #{group.cardsCount} بطاقة
        if progress.newCards
          span.new-cards #{progress.newCards} جديدة
      .progress.sm
        .progress-bar(style=`width:${group.cardsCount ? Math.min(100, progress.studied / group.cardsCount * 100) : 0}%`)

//- body of a card in a list (library / official editor / admin review)
//- draft: show the edit waiting for the admin instead of the approved version
mixin cardPreview(source, draft)
  - const card = draft && source.pendingEdit ? Object.assign(source.toObject(), source.pendingEdit.toObject()) : source
  .card-badges
    +typeBadge(card.type, card.type === 'reverse' ? ' · بطاقتان' : '')
    +approvalBadge(card.approval)
    if draft && source.pendingEdit
      if source.pendingEdit.rejected
        span.approval-badge.rejected(title='عدّل البطاقة لإرسالها مرة أخرى')
          i.fa-solid.fa-ban
          |  لم يُقبل التعديل
      else
        span.approval-badge.pending(title='يرى الآخرون النسخة السابقة حتى تتم الموافقة على التعديل')
          i.fa-solid.fa-pen-to-square
          |  التعديل قيد المراجعة
  if card.type === 'basic' || card.type === 'reverse'
    p.q= card.front
    p.a
      i.fa-solid.fa-reply
      | #{card.back}
  else if card.type === 'cloze'
    p.q!= clozeHtml(card.text)
  else
    .thumb-wrap
      img(src=card.image alt='' loading='lazy')
      each m in card.masks
        span.mask(style=`left:${m.x}%;top:${m.y}%;width:${m.w}%;height:${m.h}%`)
    p.a #{card.masks.length} منطقة مخفية

//- cards added to a published community group wait for an admin
mixin approvalBadge(approval)
  if approval === 'pending'
    span.approval-badge.pending(title='لا تظهر لغيرك حتى تتم الموافقة عليها')
      i.fa-solid.fa-hourglass-half
      |  قيد المراجعة
  else if approval === 'rejected'
    span.approval-badge.rejected(title='عدّل البطاقة لإرسالها مرة أخرى')
      i.fa-solid.fa-ban
      |  لم تُقبل

//- parents of an inner group. urlOf(id) -> link of a parent
mixin breadcrumbs(crumbs, urlOf, current)
  if crumbs && crumbs.length
    nav.breadcrumbs(aria-label='مسار المجموعة')
      each c in crumbs
        a(href=urlOf(c._id))= c.name
        i.fa-solid.fa-chevron-left(aria-hidden='true')
      span(aria-current='page')= current

//- public pages: inner groups of a group, each one can be studied alone.
//- tree is flat (depth-first + depth); rebuilt here so every group is drawn inside its parent
mixin groupTree(tree, treeProgress)
  if tree && tree.length
    - const roots = [], stack = []
    - tree.forEach(t => { const node = { group: t.group, depth: t.depth, kids: [] }; while(stack.length && stack[stack.length - 1].depth >= t.depth) stack.pop(); (stack.length ? stack[stack.length - 1].kids : roots).push(node); stack.push(node); })
    section.card-box
      h2
        i.fa-solid.fa-folder-tree
        | محتوى المجموعة
      ul.group-tree
        each node in roots
          +groupTreeNode(node, treeProgress)

mixin groupTreeNode(node, treeProgress)
  li.tree-node(class=`level-${(node.depth - 1) % 4 + 1}`)
    if node.kids.length
      details.tree-branch(open)
        summary.tree-item.is-folder
          +groupTreeRow(node.group, treeProgress, true)
        ul.tree-children
          each kid in node.kids
            +groupTreeNode(kid, treeProgress)
    else
      .tree-item
        +groupTreeRow(node.group, treeProgress, false)

mixin groupTreeRow(g, treeProgress, isFolder)
  - const p = treeProgress[g._id.toString()]
  .tree-text
    strong
      if isFolder
        i.fa-solid.fa-chevron-down.tree-toggle(aria-hidden='true')
      i.fa-solid(class=isFolder ? 'fa-folder-open' : 'fa-folder')
      |  #{g.name}
    small= g.childrenCount ? `${g.childrenCount} مجموعة · ${g.cardsCount} بطاقة` : `${g.cardsCount} بطاقة`
  if g.cardsCount
    .tree-actions
      a.btn.btn-ghost.btn-sm(href=`/anki/groups/${g._id}/study`)
        i.fa-solid.fa-book-open
        |  دراسة
      if p && p.started
        a.btn.btn-ghost.btn-sm(href=`/anki/groups/${g._id}/study?mode=revision`)
          i.fa-solid.fa-rotate
          |  مراجعة
          if p.dueNow
            span.due-count= p.dueNow
