doctype html
include _siteNav
include _bottomNav
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  meta(name='theme-color' content='#432071')
  title &#x644;&#x648;&#x62D;&#x629; &#x627;&#x644;&#x62A;&#x62D;&#x643;&#x645; &#x627;&#x644;&#x62A;&#x639;&#x644;&#x64A;&#x645;&#x64A;&#x629;
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css')
  link(rel='stylesheet' href='/css/settings.css')
  link(rel='stylesheet' href='/css/siteNav.css')
  link(rel='stylesheet' href='/css/bottomNav.css')
  <link rel="icon" type="image/png" href="/my-favicon/favicon-96x96.png?v=20260916" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/my-favicon/favicon.svg?v=20260916" />
  <link rel="shortcut icon" href="/my-favicon/favicon.ico?v=20260916" />
  <link rel="apple-touch-icon" sizes="180x180" href="/my-favicon/apple-touch-icon.png?v=20260916" />
  <meta name="apple-mobile-web-app-title" content="Studyou" />
  <link rel="manifest" href="/my-favicon/site.webmanifest?v=20260916" />
- const domain = process.env.DOMAIN_ACTIVE === 'local'? process.env.DOMAIN_LOCAL : process.env.DOMAIN_RENDER;
body(data-domain=domain)
  .layer.hidden
    .logout-container 
      p.logout-par ؟هل تريد تسجيل الخروج
      .logout-btns-container
        button.logout-btn.logout-accept= 'تاكيد'
        button.logout-btn.logout-cancel= 'الغاء'
  input#menu-toggle.menu-toggle(type='checkbox')
  .app-shell
    // طبقة الخلفية للموبايل
    label.sidebar-overlay(for='menu-toggle')
    // القائمة الرئيسية - أصبحت على اليسار
    aside.sidebar
      .sidebar-head
        span &#x627;&#x644;&#x642;&#x627;&#x626;&#x645;&#x629;
        label.close-menu(for='menu-toggle' aria-label='إغلاق القائمة') &times;
      nav.menu
        a.menu-item.active.item-number-1(role="button")
          span.menu-icon(aria-hidden='true')
            i(class='fa-solid fa-user')
          span &#x627;&#x644;&#x645;&#x639;&#x644;&#x648;&#x645;&#x627;&#x62A; &#x627;&#x644;&#x631;&#x626;&#x64A;&#x633;&#x64A;&#x629;
        a.menu-item.item-number-2(role="button")
          span.menu-icon(aria-hidden='true')
            i(class='fa-solid fa-book-open')
          span &#x627;&#x644;&#x643;&#x648;&#x631;&#x633;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x641;&#x639;&#x644;&#x629;
        a.menu-item.item-number-3(role="button")
          span.menu-icon(aria-hidden='true')
            i(class='fa-solid fa-ticket')
          span &#x62A;&#x641;&#x639;&#x64A;&#x644; &#x627;&#x644;&#x623;&#x643;&#x648;&#x627;&#x62F;
        a.menu-item.item-number-4(role="button")
          span.menu-icon(aria-hidden='true')
            i(class='fa-solid fa-bookmark')
          span الفيديوهات المحفوظة
        a.menu-item.item-number-5(role="button")
          span.menu-icon(aria-hidden='true')
            i(class='fa-solid fa-note-sticky')
          span الملاحظات المحفوظة
        a.menu-item.menu-link(href='/anki')
          span.menu-icon(aria-hidden='true')
            i(class='fa-solid fa-layer-group')
          span البطاقات
        a.menu-item.menu-link(href='/tests')
          span.menu-icon(aria-hidden='true')
            i(class='fa-solid fa-list-check')
          span الاختبارات
        a.menu-item.menu-link(href='/')
          span.menu-icon(aria-hidden='true')
            i(class='fa-solid fa-house')
          span الصفحة الرئيسية
        a.menu-item.logout-btn(role="button")
          span.menu-icon(aria-hidden='true')
            i(class='fa-solid fa-right-from-bracket')
          span تسجيل الخروج
    .page
      .notifi.hidden
        .notifi-message
      // الهيدر
      header.topbar
        .profile
          .avatar= user.name[0]
          .profile-name= user.name
        .header-actions
          +siteNav([{href: `${domain}/`, icon: 'home', label: 'الرئيسية', primary: true}])
          label.mobile-menu-button(for='menu-toggle' aria-label='فتح القائمة')
            span
            span
            span
          .notification
      main.content
        // الفيديوهات المحفوظة
        section.card.saved-videos-card.section-4.hidden
          h2 الفيديوهات المحفوظة
          .notes-loading.saved-loading.hidden
            .notes-spinner
            span جاري تحميل الفيديوهات المحفوظة...
          .saved-videos-grid
          p.saved-empty.hidden لا توجد فيديوهات محفوظة بعد

        // الملاحظات المحفوظة
        section.card.notes-card.section-5.hidden
          h2 الملاحظات المحفوظة
          .notes-lessons
          .notes-loading.hidden
            .notes-spinner
            span جاري تحميل الملاحظات...
          .notes-preview
          p.saved-empty.hidden لا توجد ملاحظات محفوظة بعد
          .notes-detail.hidden
            button.notes-back(type='button') → رجوع للدروس
            h3.notes-lesson-title
            .notes-list
        // المعلومات الشخصية
        section.card.info-card.section-1
          h2 &#x627;&#x644;&#x645;&#x639;&#x644;&#x648;&#x645;&#x627;&#x62A; &#x627;&#x644;&#x634;&#x62E;&#x635;&#x64A;&#x629;
          .info-grid
            .info-box
              .info-icon(aria-hidden='true')
                i(class='fa-solid fa-user')
              .info-text
                span.label &#x627;&#x644;&#x627;&#x633;&#x645; &#x627;&#x644;&#x643;&#x627;&#x645;&#x644;
                strong= user.name
            .info-box
              .info-icon(aria-hidden='true')
                i(class='fa-solid fa-envelope')
              .info-text
                span.label &#x627;&#x644;&#x628;&#x631;&#x64A;&#x62F; &#x627;&#x644;&#x625;&#x644;&#x643;&#x62A;&#x631;&#x648;&#x646;&#x64A;
                strong= user.email
            .info-box
              .info-icon(aria-hidden='true')
                i(class='fa-solid fa-id-badge')
              .info-text
                span.label &#x646;&#x648;&#x639; &#x627;&#x644;&#x62D;&#x633;&#x627;&#x628;
                strong= user.role === 'admin'? "ادمن": user.role === 'supervisor' ? "مشرف" : "طالب"
            if user.role === 'admin' || user.role === 'supervisor'
              a.info-box(href='/dashboard' style='text-decoration: none; color: inherit;')
                .info-icon(aria-hidden='true')
                  i(class='fa-solid fa-chart-line')
                .info-text
                  span.label لوحة الطلاب
                  strong العلامات والتقدم والمجموعات
            if user.role === 'admin'
              a.info-box(href='/dashboard/supervisors' style='text-decoration: none; color: inherit;')
                .info-icon(aria-hidden='true')
                  i(class='fa-solid fa-user-tie')
                .info-text
                  span.label المشرفون
                  strong تعيين مشرف أو إلغاء صلاحيته
            if user.role === 'admin'
              a.info-box(href='/bot-admin' style='text-decoration: none; color: inherit;')
                .info-icon(aria-hidden='true')
                  i(class='fa-brands fa-telegram')
                .info-text
                  span.label بوت تيليغرام
                  strong لوحة تحكم البوت
            // إعادة تعيين كلمة المرور
            .password-box
              .info-icon.password-icon
                svg(viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' aria-hidden='true')
                  rect(x='5' y='11' width='14' height='10' rx='2')
                  path(d='M8 11V7a4 4 0 0 1 8 0v4')
              .password-content
                label.label(for='newPassword') تغيير كلمة المرور
                .password-row
                  input#newPassword.reset-password-input(type='password' autocomplete='new-password' placeholder='كلمة المرور الجديدة')
                  button.reset-password-btn(type='button') حفظ
        section.card.color-card.section-1
          h2 &#x627;&#x644;&#x648;&#x636;&#x639; &#x627;&#x644;&#x645;&#x638;&#x644;&#x645;
          .color-row
            .toggle-wrap
              label.toggle
                input#dark-toggle(type='checkbox')
                span.slider
        // الكورسات
        section.card.courses-card.section-2.hidden
          h2 &#x627;&#x644;&#x643;&#x648;&#x631;&#x633;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x641;&#x639;&#x644;&#x629;
          .courses-grid
            each course in courses
              - const achievedCourse = courseSummaries.find(c => c.courseId.toString() == course._id.toString())
              - const percentage = Math.ceil((achievedCourse.achievedVideosCount/achievedCourse.totalVideos) * 100)
              article.course(data-course-id=course._id)
                .course-image.image-one
                 img.course-img(src=`/imgs/courses/${course.photoUrl}`)
                h3= course.title
                .progress-row
                  span &#x627;&#x644;&#x62A;&#x642;&#x62F;&#x645;
                  b= `${percentage}%`
                .progress
                  span(style=`width: ${percentage}%`)
                .course-footer
                  span= percentage > 0 && percentage < 50? "مبتدأ": percentage > 50 && percentage < 100 ? "متقدم" : "مكتمل"
                  button.enter-course-btn دخول الكورس
           
        // تفعيل الأكواد
        section.card.activation-card.section-3.hidden
          h2 &#x62A;&#x641;&#x639;&#x64A;&#x644; &#x627;&#x644;&#x623;&#x643;&#x648;&#x627;&#x62F;
          .activation-row
            input.activate-code-input(type='text' placeholder='أدخل الكود هنا')
            button.activate-code-btn(type='button') &#x62A;&#x641;&#x639;&#x64A;&#x644; &#x627;&#x644;&#x643;&#x648;&#x62F;
          .messages
            h3 &#x62C;&#x627;&#x646;&#x628; &#x645;&#x646; &#x627;&#x644;&#x646;&#x638;&#x627;&#x645;:
            ul
              li قم بنسخ الكود و لصقه هنا
              li تأكد من صحة الكود قبل التفعيل
  +bottomNav('account')
  script(src='/js/settings.js')
  script(src='/js/tests/liveBanner.js')
