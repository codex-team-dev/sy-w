doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title &#x627;&#x64A;&#x627;&#x62F; &#x633;&#x643;&#x631; - &#x645;&#x646;&#x635;&#x62A;&#x643; &#x627;&#x644;&#x623;&#x648;&#x644;&#x649; &#x644;&#x62A;&#x639;&#x644;&#x645; &#x627;&#x644;&#x639;&#x644;&#x648;&#x645;
  link(href='https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap' rel='stylesheet')
  link(rel='stylesheet' href='/css/mainpage.css')
  link(rel='stylesheet' href='/css/bottomNav.css')
  <link rel="icon" type="image/png" href="/my-favicon/favicon-96x96.png?v=20260916" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/my-favicon/favicon.svg?v=20260916" />
  <link rel="shortcut icon" href="/my-favicon/favicon.ico?v=20260916" />
  <link rel="apple-touch-icon" sizes="180x180" href="/my-favicon/apple-touch-icon.png?v=20260916" />
  <meta name="apple-mobile-web-app-title" content="Studyou" />
  <link rel="manifest" href="/my-favicon/site.webmanifest?v=20260916" />
- const domain = process.env.DOMAIN_ACTIVE === 'local'? process.env.DOMAIN_LOCAL : process.env.DOMAIN_RENDER;
body(data-domain= domain)
  .notifi.hidden
    .notifi-message
  .backdrop.hidden
    .popup-message
      h2= buy_msg || "هل تريد شراء الكورس؟"
      .buttons
        button.confirm-btn &#x62A;&#x623;&#x643;&#x64A;&#x62F;
        button.cancel-btn &#x625;&#x644;&#x63A;&#x627;&#x621;        
  // Navbar
  nav.navbar
    .navbar-inner
      .logo
        div
          .logo-text د/ إياد سكر
          .logo-sub &#x627;&#x644;&#x639;&#x644;&#x648;&#x645; &#x628;&#x623;&#x633;&#x644;&#x648;&#x628; &#x628;&#x633;&#x64A;&#x637;
      .nav-links
        a.active.section-button.section-button-1(role='button') &#x627;&#x644;&#x631;&#x626;&#x64A;&#x633;&#x64A;&#x629;
        a.section-button.section-button-2(role='button') &#x627;&#x644;&#x643;&#x648;&#x631;&#x633;&#x627;&#x62A;
        a.section-button.section-button-3(role='button') &#x639;&#x646; &#x627;&#x644;&#x645;&#x62F;&#x631;&#x633;
        a.nav-ext-link(href='/anki') البطاقات
        a.nav-ext-link(href='/tests') الاختبارات
        - if(user && (user.role === 'admin' || user.role === 'supervisor'))
          a.nav-ext-link(href='/dashboard') لوحة الطلاب
        - if(user)
          a.settings-btn(role='button') اعدادات الحساب
      - if(!user)
        button.nav-cta &#x627;&#x634;&#x62A;&#x631;&#x643; &#x627;&#x644;&#x622;&#x646;
      - if(user)
        .balance-container
          div ATP 
          .balance= `${user.value}`
      .menu-toggle-wrap
        button.mobile-menu-btn
          svg(width='28' height='28' viewbox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2')
            line(x1='3' y1='12' x2='21' y2='12')
            line(x1='3' y1='6' x2='21' y2='6')
            line(x1='3' y1='18' x2='21' y2='18')
        label.toggle
          input#dark-toggle(type='checkbox')
          span.slider
    #mobileMenu.mobile-menu
      a.active.section-button.section-button-1(role="button") &#x627;&#x644;&#x631;&#x626;&#x64A;&#x633;&#x64A;&#x629;
      a.section-button.section-button-2(role="button") &#x627;&#x644;&#x643;&#x648;&#x631;&#x633;&#x627;&#x62A;
      a.section-button.section-button-3(role="button") &#x639;&#x646; &#x627;&#x644;&#x645;&#x62F;&#x631;&#x633;
      a.nav-ext-link(href='/anki') البطاقات
      a.nav-ext-link(href='/tests') الاختبارات
      - if(user && (user.role === 'admin' || user.role === 'supervisor'))
        a.nav-ext-link(href='/dashboard') لوحة الطلاب
      - if(user)
        a.settings-btn(role="button") اعدادات الحساب
  // Main Content
  main
    // Hero Section
    section.hero.section-number-1
      .hero-inner
        .hero-content
          h1.hero-title
            | منصتك الأولى لتعلم 
            br
            |  و فهم العلوم بأسلوب
            br
            |  بسيط و ممتع!
          p.hero-subtitle
            | أهلا و سهلا في بيتك التاني!
            br
            | سواء كنت عاشر أو حادي عشر أو بكالوريا رح تلاقي كل يلي بتحتاجه لحتى تتفوق في العلوم و تفهمها صح
            br
            | هنا تفهم الأحياء..هنا تصنع الأوائل🏅

          .hero-actions
            a.hero-cta.hero-cta-primary(href='#courses') تصفح الكورسات
            if !user
              a.hero-cta.hero-cta-ghost(href='/sign-up') إنشاء حساب
            else if myCourses.length
              a.hero-cta.hero-cta-ghost(href='#my-courses') كورساتي

          .hero-stats
            .hero-stat
              .hero-stat-num +4.5K
              .hero-stat-label &#x645;&#x62A;&#x627;&#x628;&#x639;&#x64A;&#x646; &#x639;&#x644;&#x649; &#x627;&#x644;&#x64A;&#x648;&#x62A;&#x64A;&#x648;&#x628;
            .hero-stat
              .hero-stat-num +2.1
              .hero-stat-label &#x645;&#x62A;&#x627;&#x628;&#x639;&#x64A;&#x646; &#x639;&#x644;&#x649; &#x627;&#x644;&#x641;&#x64A;&#x633;&#x628;&#x648;&#x643;
        .hero-avatar-wrap
          .hero-avatar
            img.hero-img(src='/imgs/hero-img.jpg')
      .hero-deco-1
      .hero-deco-2
    if user && myCourses.length
      section#my-courses.section.my-courses-section
        .section-inner
          h2.section-title كورساتي
          .my-courses-grid
            each m in myCourses
              a.my-course-card(href=`/subcourses/${m.course._id}/lessons`)
                img.my-course-img(src=`/imgs/courses/${m.course.photoUrl}` alt='' loading='lazy')
                .my-course-body
                  h3= m.course.title
                  .my-course-bar
                    span(style=`width: ${m.percent}%`)
                  .my-course-meta
                    span= `${m.done} من ${m.total} درس`
                    span= `${m.percent}%`
                  span.my-course-cta= m.started ? 'تابع من حيث توقفت' : 'ابدأ الكورس'
    // Why Subscribe Section
    section.section.why-section
      .section-inner
        h2.section-title ليش تشترك معنا؟
        .why-grid
          .why-card
            .why-num(style='background: linear-gradient(135deg, #7c3aed, #8b5cf6)')
              | 1
            h3 &#x634;&#x631;&#x62D; &#x628;&#x633;&#x64A;&#x637; &#x648;&#x645;&#x641;&#x647;&#x648;&#x645;
            p &#x634;&#x631;&#x62D; &#x645;&#x628;&#x633;&#x637; &#x644;&#x645;&#x641;&#x627;&#x647;&#x64A;&#x645; &#x627;&#x644;&#x639;&#x644;&#x648;&#x645; &#x627;&#x644;&#x635;&#x639;&#x628;&#x629; &#x628;&#x623;&#x633;&#x644;&#x648;&#x628; &#x633;&#x644;&#x633;
          .why-card
            .why-num(style='background: linear-gradient(135deg, #10b981, #34d399)')
              | 2
