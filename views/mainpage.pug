                background: linear-gradient(135deg, #10b981, #34d399);\
                ')
                  svg(viewbox='0 0 24 24' fill='none' stroke='white' stroke-width='2')
                    path(d='M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9')
