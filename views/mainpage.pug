          .feature-img-wrap
            .feature-img-box(style='\
            background: linear-gradient(\
            135deg,\
            rgba(124, 58, 237, 0.1),\
            rgba(16, 185, 129, 0.1)\
            );\
            border-color: rgba(124, 58, 237, 0.3);\
            ')
