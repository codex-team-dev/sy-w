            p &#x631;&#x633;&#x648;&#x645;&#x627;&#x62A; &#x645;&#x62A;&#x62D;&#x631;&#x643;&#x629; &#x62A;&#x648;&#x636;&#x64A;&#x62D;&#x64A;&#x629; &#x62A;&#x633;&#x627;&#x639;&#x62F;&#x643; &#x639;&#x644;&#x649; &#x627;&#x644;&#x641;&#x647;&#x645; &#x627;&#x644;&#x639;&#x645;&#x64A;&#x642;
          .why-card
            .why-num(style='background: linear-gradient(135deg, #7c3aed, #10b981)')
              | 3
            h3 &#x62A;&#x645;&#x627;&#x631;&#x64A;&#x646; &#x62A;&#x641;&#x627;&#x639;&#x644;&#x64A;&#x629; &#x639;&#x644;&#x649; &#x627;&#x644;&#x62F;&#x631;&#x648;&#x633;
            p &#x62A;&#x645;&#x627;&#x631;&#x64A;&#x646; &#x628;&#x639;&#x62F; &#x643;&#x644; &#x62F;&#x631;&#x633; &#x644;&#x62A;&#x62B;&#x628;&#x64A;&#x62A; &#x627;&#x644;&#x645;&#x639;&#x644;&#x648;&#x645;&#x629;
          .why-card
            .why-num(style='background: linear-gradient(135deg, #8b5cf6, #a78bfa)')
              | 4
            h3 مرونة كاملة في الدراسة
            p ادرس في أي وقت و من أي مكان
          .why-card
            .why-num(style='background: linear-gradient(135deg, #059669, #10b981)')
              | 5
            h3 &#x627;&#x62E;&#x62A;&#x628;&#x627;&#x631;&#x627;&#x62A; &#x645;&#x633;&#x62A;&#x645;&#x631;&#x629;
            p &#x627;&#x62E;&#x62A;&#x628;&#x627;&#x631;&#x627;&#x62A; &#x62F;&#x648;&#x631;&#x64A;&#x629; &#x644;&#x642;&#x64A;&#x627;&#x633; &#x645;&#x633;&#x62A;&#x648;&#x627;&#x643; &#x648;&#x627;&#x644;&#x62A;&#x637;&#x648;&#x631; &#x627;&#x644;&#x645;&#x633;&#x62A;&#x645;&#x631;
          .why-card
            .why-num(style='background: linear-gradient(135deg, #7c3aed, #8b5cf6)')
              | 6
            h3 &#x645;&#x62D;&#x62A;&#x648;&#x649; &#x645;&#x62A;&#x643;&#x627;&#x645;&#x644; &#x648;&#x645;&#x646;&#x638;&#x645;
            p منهج منظم و متسلسل يسهل عليك الدراسة
          .why-card
            .why-num(style='background: linear-gradient(135deg, #10b981, #34d399)')
              | 7
            h3 &#x62A;&#x62D;&#x62F;&#x64A;&#x62B; &#x645;&#x633;&#x62A;&#x645;&#x631; &#x62D;&#x633;&#x628; &#x627;&#x644;&#x645;&#x646;&#x647;&#x62C;
            p &#x645;&#x62D;&#x62A;&#x648;&#x649; &#x64A;&#x62A;&#x645; &#x62A;&#x62D;&#x62F;&#x64A;&#x62B;&#x647; &#x628;&#x627;&#x633;&#x62A;&#x645;&#x631;&#x627;&#x631; &#x644;&#x64A;&#x62A;&#x648;&#x627;&#x641;&#x642; &#x645;&#x639; &#x627;&#x644;&#x645;&#x646;&#x647;&#x62C;
          .why-card
            .why-num(style='background: linear-gradient(135deg, #7c3aed, #10b981)')
              | 8
            h3 &#x645;&#x62C;&#x62A;&#x645;&#x639; &#x637;&#x644;&#x627;&#x628;&#x64A; &#x636;&#x62E;&#x645;
            p انضم الى مجتمع ضخم من الطلاب المتميزين و الأوائل
    // Courses Section
    section#courses.section.courses-section.section-number-2
      .section-inner
        h2.section-title &#x643;&#x648;&#x631;&#x633;&#x627;&#x62A;&#x646;&#x627; &#x627;&#x644;&#x645;&#x62A;&#x627;&#x62D;&#x629;
        p.section-subtitle &#x644;&#x644;&#x639;&#x627;&#x645; 2026/2027
        if user && user.role === 'admin'
          .courses-admin
            a.courses-admin-link(href=`/courses/${homeCourseId}/upload-subcourse`) + إضافة كورس
        .courses-grid
          if !homeCourses.length
            p.courses-empty سيتم نشر الكورسات قريبا
          each c in homeCourses
            - const owned = user && user.subcourses.map(String).includes(c._id.toString())
            .course-card(data-active-state=c.comingSoon ? null : 'active' data-course-id=c._id.toString() data-parent-id=(c.course && c.course._id ? c.course._id : c.course).toString() class=c.comingSoon ? 'is-soon' : null)
              .course-img-container
                img.course-img(src=`/imgs/courses/${c.photoUrl}` alt=c.title loading='lazy')
                if c.comingSoon
                  .course-badge.badge-soon قريبا
                else if owned
                  .course-badge.badge-owned مشترك
                if user && user.role === 'admin'
                  a.course-admin-edit(href=`/courses/${homeCourseId}/edit-subcourse/${c._id}`) تعديل
              .course-body
                h3= c.title
                p= c.description
                .course-footer
                  if owned && !c.comingSoon
                    a.course-enter(href=`/subcourses/${c._id}/lessons`) ادخل الكورس
                  else
                    span.course-price= `${c.price || 0} ATP`
                    if !c.comingSoon
                      button.course-btn اشترك الآن

    // Features Detail Section
    section.section.features-section
      .section-inner
        .feature-row
          .feature-text
            .feature-icon-box(style='background: linear-gradient(135deg, #7c3aed, #8b5cf6)')
