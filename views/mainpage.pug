            .feature-img-box(style='\
            background: linear-gradient(\
            135deg,\
            rgba(16, 185, 129, 0.1),\
            rgba(124, 58, 237, 0.1)\
            );\
            border-color: rgba(16, 185, 129, 0.3);\
            ')
              svg(viewbox='0 0 24 24' fill='none' stroke='#10B981' stroke-width='1')
                polygon(points='23 7 16 12 23 17 23 7')
                rect(x='1' y='5' width='15' height='14' rx='2' ry='2')
          .feature-text
            .feature-icon-box(style='background: linear-gradient(135deg, #10b981, #34d399)')
              svg(viewbox='0 0 24 24' fill='none' stroke='white' stroke-width='2')
                polygon(points='23 7 16 12 23 17 23 7')
                rect(x='1' y='5' width='15' height='14' rx='2' ry='2')
            h3.feature-title دروس بالفيديو و الصور التوضيحية
            p.feature-desc
              | شروحات مصورة بقيمة علمية متميزة وتقنيات حديثة، تجمع لك بين التفوق الدراسي والراحة الذهنية(رفاهيتك بتهمنا عزيزي الطالب..اتدلل)
        .feature-row
          .feature-text
            .feature-icon-box(style='background: linear-gradient(135deg, #8b5cf6, #a78bfa)')
              svg(viewbox='0 0 24 24' fill='none' stroke='white' stroke-width='2')
                path(d='M9 11l3 3L22 4')
                path(d='M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11')
            h3.feature-title اختبارات وتمارين تفاعلية
            p.feature-desc
              | اسئلة مؤتمتة مرافقة لكل درس لتثبيت المعلومة وتختبر نفسك،ويتم عرض الجواب الصحيح مباشرةً
          .feature-img-wrap
            .feature-img-box(style='\
            background: linear-gradient(\
            135deg,\
            rgba(139, 92, 246, 0.1),\
            rgba(16, 185, 129, 0.1)\
            );\
            border-color: rgba(139, 92, 246, 0.3);\
            ')
